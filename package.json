{
    "activationEvents": [
        "onStartupFinished"
    ],
    "author": {
        "name": "EggRoll"
    },
    "bugs": {
        "url": "https://github.com/Jy-EggRoll/tree-enhancer/issues"
    },
    "categories": [
        "Other"
    ],
    "contributes": {
        "views": {
            "explorer": [
                {
                    "id": "tree-enhancer.terminalExplorer",
                    "name": "%description.terminalExplorer%",
                    "when": "config.tree-enhancer.terminalExplorer.enabled"
                }
            ]
        },
        "commands": [
            {
                "command": "tree-enhancer.calculateFolder",
                "title": "%description.calculateFolder%"
            },
            {
                "command": "tree-enhancer.newFile",
                "title": "%description.terminalExplorer.newFile%",
                "icon": "$(new-file)"
            },
            {
                "command": "tree-enhancer.newFolder",
                "title": "%description.terminalExplorer.newFolder%",
                "icon": "$(new-folder)"
            },
            {
                "command": "tree-enhancer.rename",
                "title": "%description.terminalExplorer.rename%",
                "icon": "$(edit)"
            },
            {
                "command": "tree-enhancer.deleteFile",
                "title": "%description.terminalExplorer.delete%",
                "icon": "$(trash)"
            },
            {
                "command": "tree-enhancer.deletePermanently",
                "title": "%description.terminalExplorer.deletePermanently%",
                "icon": "$(trash)"
            },
            {
                "command": "tree-enhancer.revealInExplorer",
                "title": "%description.terminalExplorer.revealInExplorer%",
                "icon": "$(eye)"
            },
            {
                "command": "tree-enhancer.upload",
                "title": "%description.terminalExplorer.upload%",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "tree-enhancer.download",
                "title": "%description.terminalExplorer.download%",
                "icon": "$(cloud-download)"
            }
        ],
        "configuration": {
            "properties": {
                "tree-enhancer.dateTimeFormat": {
                    "default": "YYYY-MM-DD HH:mm:ss",
                    "description": "%description.dateTimeFormat%",
                    "type": "string"
                },
                "tree-enhancer.fileInfo.enabled": {
                    "default": true,
                    "description": "%description.fileInfo.enabled%",
                    "type": "boolean"
                },
                "tree-enhancer.fileSizeBase": {
                    "default": 1000,
                    "description": "%description.fileSizeBase%",
                    "enum": [
                        1000,
                        1024
                    ],
                    "type": "number"
                },
                "tree-enhancer.fileTemplate": {
                    "default": {
                        "fileString": "%default.fileTemplate%"
                    },
                    "description": "%description.fileTemplate%",
                    "type": "object"
                },
                "tree-enhancer.folderCalculator.dismissDelay": {
                    "default": 10,
                    "description": "%description.folderCalculator.dismissDelay%",
                    "maximum": 3600,
                    "minimum": 0,
                    "type": "number"
                },
                "tree-enhancer.folderCalculator.statusBarTemplate": {
                    "default": "%default.folderCalculator.statusBarTemplate%",
                    "description": "%description.folderCalculator.statusBarTemplate%",
                    "type": "string"
                },
                "tree-enhancer.imageFileTemplate": {
                    "default": {
                        "imageFileString": "%default.imageFileTemplate%"
                    },
                    "description": "%description.imageFileTemplate%",
                    "type": "object"
                },
                "tree-enhancer.imageResolutionTemplate": {
                    "default": "%default.imageResolutionTemplate%",
                    "description": "%description.imageResolutionTemplate%",
                    "type": "string"
                },
                "tree-enhancer.largeFileThreshold": {
                    "default": 20,
                    "description": "%description.largeFileThreshold%",
                    "maximum": 1000,
                    "minimum": 0,
                    "type": "number"
                },
                "tree-enhancer.startupDelay": {
                    "default": 0,
                    "description": "%description.startupDelay%",
                    "maximum": 10,
                    "minimum": 0,
                    "type": "number"
                },
                "tree-enhancer.terminalExplorer.enabled": {
                    "default": true,
                    "description": "%description.terminalExplorer.enabled%",
                    "type": "boolean"
                }
            },
            "title": "Tree Enhancer"
        },
        "keybindings": [
            {
                "command": "tree-enhancer.calculateFolder",
                "key": "alt+enter",
                "when": "explorerViewletFocus && explorerResourceIsFolder"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "tree-enhancer.calculateFolder",
                    "group": "navigation@99",
                    "when": "explorerResourceIsFolder"
                }
            ],
            "view/item/context": [
                {
                    "command": "tree-enhancer.newFile",
                    "when": "view == tree-enhancer.terminalExplorer && viewItem == folder",
                    "group": "inline@1"
                },
                {
                    "command": "tree-enhancer.newFolder",
                    "when": "view == tree-enhancer.terminalExplorer && viewItem == folder",
                    "group": "inline@2"
                },
                {
                    "command": "tree-enhancer.rename",
                    "when": "view == tree-enhancer.terminalExplorer && viewItem == file",
                    "group": "inline@1"
                },
                {
                    "command": "tree-enhancer.rename",
                    "when": "view == tree-enhancer.terminalExplorer && viewItem == file",
                    "group": "5_modification@1"
                },
                {
                    "command": "tree-enhancer.rename",
                    "when": "view == tree-enhancer.terminalExplorer && viewItem == folder",
                    "group": "5_modification@1"
                },
                {
                    "command": "tree-enhancer.deleteFile",
                    "when": "view == tree-enhancer.terminalExplorer",
                    "group": "5_modification@2"
                },
                {
                    "command": "tree-enhancer.deletePermanently",
                    "when": "view == tree-enhancer.terminalExplorer",
                    "group": "5_modification@3"
                },
                {
                    "command": "tree-enhancer.revealInExplorer",
                    "when": "view == tree-enhancer.terminalExplorer",
                    "group": "navigation@99"
                },
                {
                    "command": "tree-enhancer.upload",
                    "when": "view == tree-enhancer.terminalExplorer && viewItem == folder",
                    "group": "5b_importexport@1"
                },
                {
                    "command": "tree-enhancer.download",
                    "when": "view == tree-enhancer.terminalExplorer && viewItem == file",
                    "group": "5b_importexport@2"
                }
            ],
            "view/title": [
                {
                    "command": "tree-enhancer.newFile",
                    "when": "view == tree-enhancer.terminalExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "tree-enhancer.newFolder",
                    "when": "view == tree-enhancer.terminalExplorer",
                    "group": "navigation@2"
                }
            ]
        }
    },
    "dependencies": {
        "image-size": "^2.0.2",
        "minimatch": "^9.0.0",
        "source-map-support": "^0.5.21"
    },
    "description": "Show more information in the VSCode file explorer when hovering over files | 鼠标悬浮时在 VSCode 资源管理器中显示文件的详细信息",
    "devDependencies": {
        "@types/node": "20.x",
        "@types/source-map-support": "^0.5.10",
        "@types/vscode": "^1.93.0",
        "@vscode/l10n-dev": "^0.0.35",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/vsce": "^3.3.2",
        "esbuild": "^0.25.9",
        "typescript": "^5.8.3"
    },
    "displayName": "Tree Enhancer",
    "engines": {
        "vscode": "^1.93.0"
    },
    "homepage": "https://github.com/Jy-EggRoll/tree-enhancer#readme",
    "icon": "icon.png",
    "keywords": [
        "file",
        "explorer",
        "size",
        "tooltip",
        "show size",
        "文件管理器",
        "文件",
        "信息"
    ],
    "l10n": "./l10n",
    "license": "MIT",
    "main": "./dist/extension.js",
    "name": "eggroll-tree-enhancer",
    "publisher": "Jy-EggRoll",
    "repository": {
        "type": "git",
        "url": "https://github.com/Jy-EggRoll/tree-enhancer.git"
    },
    "scripts": {
        "check-types": "pnpm tsc --noEmit",
        "compile": "pnpm run check-types && node esbuild.js",
        "compile-tests": "pnpm tsc -p . --outDir out",
        "gen-l10n": "npx @vscode/l10n-dev export -o ./l10n ./src && node scripts/sort-l10n.mjs",
        "package": "pnpm run check-types && node esbuild.js --production",
        "vscode:prepublish": "pnpm run package"
    },
    "version": "1.11.0"
}