// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "compile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "compile",
			"problemMatcher": []
		},
		{
			"type": "npm",
			"script": "compile-tests",
			"group": "build",
			"label": "compile-tests",
			"problemMatcher": "$tsc-watch"
		}
	]
}
